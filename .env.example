# Copy this file to .env and fill in what you have. Everything is optional:
# without any key the app still works and the report is written by code (no AI).
# If several are set, the app lets you choose; the first one below is the default.

# --- Google Gemini (free tier): https://aistudio.google.com
GEMINI_API_KEY=

# --- Anthropic Claude (paid): https://platform.claude.com
ANTHROPIC_API_KEY=

# --- Any other company that speaks the OpenAI format.
# Fill in all three. LLM_MODEL = a model name from that company's docs.
#
#   Company      LLM_BASE_URL
#   OpenAI       (leave empty)
#   Mistral      https://api.mistral.ai/v1
#   Groq         https://api.groq.com/openai/v1
#   DeepSeek     https://api.deepseek.com
#   OpenRouter   https://openrouter.ai/api/v1      (one key, many companies' models)
#   Ollama       http://localhost:11434/v1         (free, runs on your computer; no key needed)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
